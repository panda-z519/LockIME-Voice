<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Non-sandboxed Developer ID app. Accessibility APIs are incompatible with
	     the App Sandbox, so com.apple.security.app-sandbox is intentionally absent.
	     Release preview builds are ad-hoc signed and embed Sparkle from SPM, so
	     Library Validation must be disabled or macOS rejects Sparkle at launch. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
